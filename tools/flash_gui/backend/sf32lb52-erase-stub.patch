+#[cfg(test)]
+mod erase_ack_tests {
+    use super::*;
+    use crate::common::serial_io::test_support::TestSerialPort;
+    use crate::progress::no_op_progress_sink;
+    use crate::{BeforeOperation, CancelToken};
+
+    fn tool(reply: &[u8]) -> SF32LB52Tool {
+        let (port, _) = TestSerialPort::from_bytes(reply);
+        SF32LB52Tool {
+            base: SifliToolBase::new_with_external_stub_and_cancel(
+                "test".into(), BeforeOperation::NoReset, "nor".into(),
+                1_000_000, 1, false, no_op_progress_sink(), None, CancelToken::new(),
+            ),
+            port: Box::new(port),
+        }
+    }
+
+    #[test]
+    fn single_final_ok_completes_erase() {
+        tool(b"OK\n").internal_erase_all(0x12000000).unwrap();
+    }
+
+    #[test]
+    fn final_fail_is_reported_without_waiting_for_another_ack() {
+        let error = tool(b"Fail\n").internal_erase_all(0x12000000).unwrap_err();
+        assert!(error.to_string().contains("returned Fail"), "{error}");
+    }
+}
